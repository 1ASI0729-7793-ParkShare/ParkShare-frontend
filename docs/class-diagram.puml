@startuml shared-kernel
title Shared kernel
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho
hide empty members

interface BaseEntity {
  +id: number
}
interface BaseResource {
  +id: number
}
interface BaseResponse
interface BaseAssembler<TEntity, TResource, TResponse> {
  +toEntitiesFromResponse(response): TEntity[]
  +toEntityFromResource(resource): TEntity
  +toResourceFromEntity(entity): TResource
}
abstract class BaseApi {
  #http: HttpClient
  #baseUrl: string
}
abstract class BaseApiEndpoint<TEntity, TResource, TResponse> {
  -http: HttpClient
  -endpointUrl: string
  -assembler: BaseAssembler
  +getAll(): Observable<TEntity[]>
  +getById(id): Observable<TEntity>
  +create(entity): Observable<TEntity>
  +update(entity, id): Observable<TEntity>
  +delete(id): Observable<void>
}
class FileUploadService <<Service>> {
  +upload(file: Blob, fileName): Observable<string>
  +resolvePhotos(photos: string[]): Observable<string[]>
}
class Layout
class LanguageSwitcher
class Placeholder

BaseApiEndpoint o--> BaseAssembler
BaseAssembler ..> BaseEntity
BaseAssembler ..> BaseResource
BaseAssembler ..> BaseResponse
BaseApiEndpoint ..> BaseResource
FileUploadService ..> BaseApi : uses HttpClient
Layout *-- LanguageSwitcher
@enduml

